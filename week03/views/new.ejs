<%- include('partials/header', { title: '글쓰기' }) %>

<h2>새 게시글 작성</h2>

<form action="/posts" method="POST">
  <div>
    <label for="title">제목</label>
    <input
      type="text"
      id="title"
      name="title"
      required
    >
  </div>

  <br>

  <div>
    <label for="content">내용</label>
    <textarea
      id="content"
      name="content"
      rows="10"
      required
    ></textarea>
  </div>

  <br>

  <button type="submit">작성</button>
  <a href="/posts">취소</a>
</form>

<%- include('partials/footer') %>