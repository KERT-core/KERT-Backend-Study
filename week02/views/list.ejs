<%-include('partials/header')%>
<h2>글 목록</h2>
<a href="/posts/new">글쓰기</a>
<%if(posts.length === 0) {%>  <%#글이 없으면->'글이 없습니다'%>
    <p>글이 없습니다</p>
<%} else {%>
    <ul>
        <% for(const post of posts) { %>
         <li>
            <a href="/posts/<%=post.id%>">[<%=post.id%>]<%=post.title%></a>
            (<%=post.author%>)
         </li>
        <%} %>
    </ul>
    <%}%>
<%-include('partials/footer')%>